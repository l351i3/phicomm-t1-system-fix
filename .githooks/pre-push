#!/bin/sh
# pre-push —— 推送前全量扫描跟踪文件（受保护模式 / 结构卫生）
set -e
cd "$(git rev-parse --show-toplevel)"

PY=""
for c in python3 python3.13 python; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-push: 未找到 python3，拒绝推送（fail-closed）" >&2
  exit 1
fi

exec "$PY" .githooks/leak_scan.py --all
